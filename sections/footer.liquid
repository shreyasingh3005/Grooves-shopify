{%- style -%}
  .custom-footer-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: inherit;
    color: {{ section.settings.text_color }};
    border-top: 1px solid rgba(0,0,0,0.05);
  }

  .custom-footer-inner {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Grid Alignment with balanced spacing */
  .custom-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 50px;
    align-items: start;
  }

  @media screen and (min-width: 768px) {
    .custom-footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media screen and (min-width: 1024px) {
    .custom-footer-grid {
      /* Perfect equal balance for all 4 columns */
      grid-template-columns: 1.2fr 1fr 1fr 1.5fr;
      gap: 50px;
    }
  }

  /* Headings - Premium Look */
  .footer-block-heading {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 24px;
    color: {{ section.settings.heading_color }};
    letter-spacing: 0.5px;
  }

  /* Link Lists */
  .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-menu li {
    margin-bottom: 14px;
  }

  .footer-menu a {
    text-decoration: none;
    color: {{ section.settings.text_color }};
    font-size: 14px;
    opacity: 0.8;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .footer-menu a:hover {
    opacity: 1;
    color: {{ section.settings.heading_color }};
    transform: translateX(3px);
  }

  /* Contact Info */
  .footer-contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-contact-item {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    font-size: 14px;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
  }

  .footer-contact-item svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .footer-contact-item a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .footer-contact-item a:hover {
    color: {{ section.settings.heading_color }};
    opacity: 1;
  }

  /* Text Block (Address) */
  .footer-text-block {
    font-size: 14px;
    line-height: 1.8;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
  }

  /* Brand Info Block */
  .footer-brand-info {
    text-align: center;
  }
  
  @media screen and (min-width: 1024px) {
    .footer-brand-info {
      text-align: left;
    }
  }

  .footer-logo {
    max-width: {{ section.settings.logo_max_width }}px;
    height: auto;
    margin: 0 auto 20px auto;
    display: block;
  }
  
  @media screen and (min-width: 1024px) {
    .footer-logo {
      margin: 0 0 20px 0;
    }
  }

  .footer-brand-subtitle {
    font-size: 13px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin-bottom: 15px;
    letter-spacing: 0.3px;
  }

  .footer-brand-desc {
    font-size: 14px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    opacity: 0.85;
    font-style: italic;
  }

  /* Policies Links Row */
  .footer-policies {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px 25px;
    list-style: none;
    padding: 0 0 25px 0;
    margin: 0 0 25px 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .footer-policies a {
    color: {{ section.settings.text_color }};
    font-size: 13px;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  .footer-policies a:hover {
    opacity: 1;
    color: {{ section.settings.heading_color }};
  }

  /* Footer Bottom */
  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding-top: 20px;
    align-items: center;
    text-align: center;
  }

  @media screen and (min-width: 1024px) {
    .footer-bottom {
      grid-template-columns: 1fr auto 1fr;
      text-align: left;
    }
  }

  .footer-socials {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  @media screen and (min-width: 1024px) {
    .footer-socials {
      justify-content: flex-start;
    }
  }

  .footer-socials a {
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .footer-socials a:hover {
    color: {{ section.settings.heading_color }};
    opacity: 1;
    transform: translateY(-2px);
  }

  .footer-socials svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .grooves-whatsapp {
    position: fixed;
    right: 20px;
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 30;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  .grooves-whatsapp:hover,
  .grooves-whatsapp:focus-visible {
    background: #1da851;
    color: #ffffff;
  }

  .grooves-whatsapp svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }

  @media screen and (max-width: 749px) {
    .grooves-whatsapp {
      right: 16px;
      bottom: max(16px, env(safe-area-inset-bottom));
    }
  }

  .footer-copyright {
    font-size: 13px;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    text-align: center;
    letter-spacing: 0.2px;
  }

  .footer-payments-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
  }

  @media screen and (min-width: 1024px) {
    .footer-payments-wrapper {
      justify-content: flex-end;
    }
  }

  .footer-payments {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: center;
  }

  .footer-payments svg {
    width: 35px;
    height: auto;
  }
{%- endstyle -%}

<footer class="custom-footer-{{ section.id }}">
  <div class="custom-footer-inner">
    
    <!-- Top Grid Section -->
    <div class="custom-footer-grid">
      {%- for block in section.blocks -%}
        <div class="footer-block" {{ block.shopify_attributes }}>
          
          {%- case block.type -%}
            
            {%- when 'link_list' -%}
              {%- if block.settings.heading != blank -%}
                <div class="footer-block-heading">{{ block.settings.heading }}</div>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer-menu">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- when 'contact_info' -%}
              {%- if block.settings.heading != blank -%}
                <div class="footer-block-heading">{{ block.settings.heading }}</div>
              {%- endif -%}
              <ul class="footer-contact-list">
                {%- if block.settings.email != blank -%}
                  <li class="footer-contact-item">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                  </li>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <li class="footer-contact-item">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a>
                  </li>
                {%- endif -%}
              </ul>

            {%- when 'text_block' -%}
              {%- if block.settings.heading != blank -%}
                <div class="footer-block-heading">{{ block.settings.heading }}</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer-text-block">{{ block.settings.text }}</div>
              {%- endif -%}

            {%- when 'brand_info' -%}
              <div class="footer-brand-info">
                {%- if block.settings.logo != blank -%}
                  <img 
                    src="{{ block.settings.logo | image_url: width: 400 }}" 
                    alt="{{ shop.name }}" 
                    class="footer-logo"
                    loading="lazy"
                    width="{{ section.settings.logo_max_width }}"
                    height="auto"
                  >
                {%- else -%}
                  <h2 class="footer-block-heading">{{ shop.name }}</h2>
                {%- endif -%}
                
                {%- if block.settings.subtitle != blank -%}
                  <div class="footer-brand-subtitle">{{ block.settings.subtitle }}</div>
                {%- endif -%}
                
                {%- if block.settings.description != blank -%}
                  <div class="footer-brand-desc">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- Dynamic Policies Links List (Added as requested) -->
    {%- if section.settings.show_policies and shop.policies != empty -%}
      <ul class="footer-policies">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li>
              <a href="{{ policy.url }}">{{ policy.title }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <!-- Bottom Section -->
    <div class="footer-bottom">
      
      <div class="footer-socials">
        {%- if section.settings.show_social -%}
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zM17.5 6.5h.01"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.twitter_url != blank -%}
            <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
              <svg viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <svg viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 00-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 00-1.94 2A29 29 0 001 11.75a29 29 0 00.46 5.33A2.78 2.78 0 003.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 001.94-2 29 29 0 00.46-5.25 29 29 0 00-.46-5.33zM9.75 15.02V8.48l6.5 3.27-6.5 3.27z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.linkedin_url != blank -%}
            <a href="{{ section.settings.linkedin_url }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24"><path d="M6.5 8.5H3V21h3.5V8.5ZM4.75 3A2.05 2.05 0 1 0 4.75 7.1 2.05 2.05 0 0 0 4.75 3ZM21 13.5c0-3.75-2-5.5-4.65-5.5a4.05 4.05 0 0 0-3.65 2.05V8.5H9.2V21h3.5v-6.2c0-1.65.3-3.25 2.35-3.25 2 0 2 1.9 2 3.35V21H21v-7.5Z"/></svg>
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="footer-copyright">
        &copy; {{ 'now' | date: "%Y" }}. All rights reserved by <strong>{{ section.settings.copyright_name | default: shop.name | upcase }}</strong>.
      </div>

      <div class="footer-payments-wrapper">
        {%- if section.settings.show_payment_icons -%}
          <ul class="footer-payments">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

    </div>
  </div>
</footer>

{%- if section.settings.whatsapp_url != blank -%}
  <a class="grooves-whatsapp" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener noreferrer" aria-label="Chat with Grooves on WhatsApp">
    <svg viewBox="0 0 20 20" aria-hidden="true">{% render 'icon', icon: 'whatsapp' %}</svg>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "Custom Premium Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#444444"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Policies Links"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show store policies (Return, Privacy, Terms, etc.)",
      "default": true
    },
    {
      "type": "header",
      "content": "Footer Bottom"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Grooves Social Links"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL",
      "default": "https://www.facebook.com/people/grooves-powered-by-infiniarc/61556742414399/"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/grooves_audio/"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL",
      "default": "https://www.youtube.com/@grooves_audio"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X/Twitter URL",
      "default": ""
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL",
      "default": "https://www.linkedin.com/company/grooves-audio/home/"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp URL",
      "default": "https://wa.me/9216921661"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright Entity Name",
      "default": "MEWALT ELECTRONICS PRIVATE LIMITED",
      "info": "Leave blank to use store name."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact_info",
      "name": "Contact Info",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Support"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email Address",
          "default": "support@yourdomain.com"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone Number",
          "default": "(+91) 0000-0000-00"
        }
      ]
    },
    {
      "type": "text_block",
      "name": "Text Box / Address",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Address"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>SB 68 / A95 SECTOR 63A NOIDA 201307</p>"
        }
      ]
    },
    {
      "type": "brand_info",
      "name": "Brand Information",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Locations",
          "default": "India | Saudi Arabia | Dubai"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>An Indian brand delivering high-performance audio, smart wearables, and mobile accessories at affordable prices. Engineered for everyday life.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Premium Footer",
      "blocks": [
        { "type": "link_list" },
        { "type": "contact_info" },
        { "type": "text_block" },
        { "type": "brand_info" }
      ]
    }
  ]
}
{% endschema %}